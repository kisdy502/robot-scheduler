<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zioneer.robotscheduler</groupId>
        <artifactId>robot-scheduler</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>robot-scheduler-boot</artifactId>
    <name>robot-scheduler-boot</name>
    <description>启动装配：组装 api/core/rms-client/persistence，提供服务运行时配置</description>

    <dependencies>
        <dependency>
            <groupId>com.zioneer.robotscheduler</groupId>
            <artifactId>robot-scheduler-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zioneer.robotscheduler</groupId>
            <artifactId>robot-scheduler-rms-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zioneer.robotscheduler</groupId>
            <artifactId>robot-scheduler-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
